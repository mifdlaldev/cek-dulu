# Template environment variables — SALIN ke `.env` lalu isi nilainya.
# JANGAN commit file `.env`. Sudah dikecualikan di .gitignore.
#
# API key didapat dari: https://aistudio.google.com/u/0/api-keys
# Klik tombol "Create API key", lalu salin nilainya ke bawah.
#
# Sumber nama variabel: Sesi 2 p.32, Sesi 3 p.27.
GEMINI_API_KEY=
